set -eu

echo "==> Adding user 'nitrux'."

LIVE_USER="nitrux"
LIVE_USER_GROUPS=(
    adm
    bluetooth
    cdrom
    dip
    fuse
    gamemode
    input
    pipewire
    plugdev
    sambashare
    sudo
    video
    wheel
)

for group in "${LIVE_USER_GROUPS[@]}"; do
    if ! getent group "$group" > /dev/null; then
        groupadd "$group"
    else
        echo "Group '$group' already exists. Skipping creation."
    fi
done

IFS=',' joined_groups="${LIVE_USER_GROUPS[*]}"

useradd -G "${joined_groups}" -m "$LIVE_USER"

LIVE_PASSWORD='nitrux'

printf '%s\n' "$LIVE_PASSWORD" "$LIVE_PASSWORD" | passwd "$LIVE_USER"
